---
import SkillCard from "../components/SkillCard.astro";

const skills = [
  {
    name: "HTML",
    icon: "/icons/skills/HTML5.svg",
  },
  {
    name: "CSS",
    icon: "/icons/skills/CSS.svg",
  },
  {
    name: "Astro",
    icon: "/icons/skills/Astro.svg",
  },
  {
    name: "Python",
    icon: "/icons/skills/Python.svg",
  },
  {
    name: "MySQL",
    icon: "/icons/skills/MySQL.svg",
  },
  {
    name: "Power BI",
    icon: "/icons/skills/PowerBI.svg",
  },
  {
    name: "Blender",
    icon: "/icons/skills/Blender.svg",
  },
  {
    name: "Photoshop",
    icon: "/icons/skills/Photoshop.svg",
  },
];
---

<section class="skills" id="habilidades">
  <div class="skills__content">
    <p class="skills__eyebrow">Habilidades</p>

    <h2>Tecnologías y herramientas</h2>

    <div class="skills__grid">
      {skills.map((skill) => <SkillCard name={skill.name} icon={skill.icon} />)}
    </div>
  </div>
</section>

<style>
  .skills {
    padding: 6rem 2rem;
    background: #0f172a;
    color: white;
  }

  .skills__content {
    width: min(1200px, calc(100% - 4rem));
    margin: 0 auto;
  }

  .skills__eyebrow {
    color: #60a5fa;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .skills h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin: 0.5rem 0 2rem;
  }

  .skills__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
</style>
